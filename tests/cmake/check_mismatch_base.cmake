# Run samstat --json on one input and check the mismatch_base key of every position block
# (read1 and read2 when present, absolute and relative axis):
#   - it is written right after "mismatches" and before "insertions", with the four mapq ids
#     in the fixed order and in each the five bases A C G T N in that order (checked on the
#     text: string(JSON MEMBER) returns members sorted by name, not in file order)
#   - every class has the five bases
#   - the five arrays add up to the mismatches array of the class, element by element, and
#     the longest of them is exactly as long as the mismatches array (same trimming)
#   - the unmapped class has five empty arrays
# and that docs/samstat.schema.json lists mismatch_base in the position block without
# requiring it (an optional field added in 2.5.0: files written by 2.4.0 still validate).
# Required: -DSAMSTAT=<binary> -DINPUT=<file> -DOUTDIR=<dir> -DSCHEMA=<schema file>

cmake_minimum_required(VERSION 3.19)

include(${CMAKE_CURRENT_LIST_DIR}/outdir_guard.cmake)
file(REMOVE_RECURSE ${OUTDIR})
file(MAKE_DIRECTORY ${OUTDIR})
execute_process(TIMEOUT 120 COMMAND ${SAMSTAT} --json -d ${OUTDIR} ${INPUT}
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "samstat exited with ${rc}\n${out}\n${err}")
endif()
get_filename_component(name ${INPUT} NAME)
file(READ ${OUTDIR}/${name}.samstat.json doc)

# --- schema: listed, not required ---------------------------------------------------------
file(READ ${SCHEMA} schema)
string(JSON s_pos GET "${schema}" "$defs" position)
string(JSON ignored ERROR_VARIABLE e_prop GET "${s_pos}" properties mismatch_base)
if(NOT e_prop STREQUAL "NOTFOUND")
  message(SEND_ERROR "schema: mismatch_base is not a property of the position block")
endif()
string(JSON nreq LENGTH "${s_pos}" required)
math(EXPR lastreq "${nreq}-1")
foreach(i RANGE 0 ${lastreq})
  string(JSON r GET "${s_pos}" required ${i})
  if(r STREQUAL "mismatch_base")
    message(SEND_ERROR "schema: mismatch_base is required; it must stay optional (2.4.0 files lack it)")
  endif()
endforeach()

set(bases A C G T N)
set(classes mapq_ge30 mapq_10_29 mapq_lt10 unmapped)
set(n_mb_values 0)

# one position block: <label> for messages, <pos> the block's JSON text
function(check_block label pos)
  set(cnt ${n_mb_values})
  string(JSON ignored ERROR_VARIABLE e_mb GET "${pos}" mismatch_base)
  if(NOT e_mb STREQUAL "NOTFOUND")
    message(SEND_ERROR "${label}: no mismatch_base")
    return()
  endif()
  string(JSON mis_all GET "${pos}" mismatches)
  string(JSON mb_all GET "${pos}" mismatch_base)
  # the four classes
  string(JSON nc LENGTH "${mb_all}")
  if(NOT nc EQUAL 4)
    message(SEND_ERROR "${label}: mismatch_base has ${nc} classes, expected 4")
  endif()
  foreach(c IN LISTS classes)
    string(JSON mis GET "${mis_all}" ${c})
    string(JSON n_mis LENGTH "${mis}")
    string(JSON per GET "${mb_all}" ${c})
    string(JSON nb LENGTH "${per}")
    if(NOT nb EQUAL 5)
      message(SEND_ERROR "${label}.${c}: ${nb} bases, expected 5")
      continue()
    endif()
    set(longest 0)
    foreach(b IN LISTS bases)
      string(JSON arr_${b} GET "${per}" ${b})
      string(JSON len_${b} LENGTH "${arr_${b}}")
      if(len_${b} GREATER longest)
        set(longest ${len_${b}})
      endif()
      if(c STREQUAL "unmapped" AND len_${b} GREATER 0)
        message(SEND_ERROR "${label}.unmapped.${b}: ${len_${b}} entries, expected []")
      endif()
    endforeach()
    if(NOT longest EQUAL n_mis)
      message(SEND_ERROR "${label}.${c}: longest base array has ${longest} entries, mismatches has ${n_mis}")
    endif()
    if(n_mis GREATER 0)
      math(EXPR lastp "${n_mis}-1")
      foreach(p RANGE 0 ${lastp})
        string(JSON m GET "${mis}" ${p})
        set(sum 0)
        foreach(b IN LISTS bases)
          if(p LESS len_${b})
            string(JSON v GET "${arr_${b}}" ${p})
            math(EXPR sum "${sum}+${v}")
          endif()
        endforeach()
        if(NOT sum EQUAL m)
          message(SEND_ERROR "${label}.${c}[${p}]: mismatch_base adds up to ${sum}, mismatches is ${m}")
        endif()
      endforeach()
      math(EXPR cnt "${cnt}+${n_mis}")
    endif()
  endforeach()
  set(n_mb_values ${cnt} PARENT_SCOPE)
endfunction()

# file order, on the text: one line per key, mismatch_base between mismatches and insertions
set(arr [=[\[[0-9,]*\]]=])
set(per_base "{\"A\": ${arr}, \"C\": ${arr}, \"G\": ${arr}, \"T\": ${arr}, \"N\": ${arr}}")
set(line "\"mismatch_base\": {\"mapq_ge30\": ${per_base}, \"mapq_10_29\": ${per_base}, \"mapq_lt10\": ${per_base}, \"unmapped\": ${per_base}}")
string(REGEX MATCHALL "\n\"mismatches\": [^\n]*,\n${line},\n\"insertions\": " found "${doc}")
list(LENGTH found n_found)
string(JSON n_r2 GET "${doc}" summary read2_reads)
set(n_blocks 2)
if(n_r2 GREATER 0)
  set(n_blocks 4)
endif()
if(NOT n_found EQUAL n_blocks)
  message(SEND_ERROR "${name}: ${n_found} position blocks have mismatch_base in the expected place and form, expected ${n_blocks}")
endif()

foreach(r read1 read2)
  string(JSON d_read ERROR_VARIABLE e_read GET "${doc}" ${r})
  if(NOT e_read STREQUAL "NOTFOUND")
    continue()
  endif()
  foreach(axis absolute relative)
    string(JSON pos GET "${d_read}" ${axis})
    check_block("${name}: ${r}.${axis}" "${pos}")
  endforeach()
endforeach()
message(STATUS "mismatch_base of ${name}: order, shape and sums match (${n_mb_values} non-trimmed bins)")
