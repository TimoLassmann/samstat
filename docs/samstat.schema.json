{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TimoLassmann/SAMStat/docs/samstat.schema.json",
  "title": "SAMStat JSON report (format_version 2)",
  "description": "Written by 'samstat --json' as <input>.samstat.json. See docs/json-format.md.",
  "type": "object",
  "required": [
    "format_version",
    "meta",
    "summary",
    "mapq_bins",
    "axes",
    "read1"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 2
    },
    "meta": {
      "type": "object",
      "required": [
        "samstat_version",
        "input_file"
      ],
      "additionalProperties": false,
      "properties": {
        "samstat_version": {
          "type": "string"
        },
        "input_file": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_reads",
        "read1_reads",
        "read2_reads",
        "paired",
        "properly_paired",
        "secondary",
        "supplementary",
        "is_aligned",
        "is_partial_report",
        "total_bases",
        "min_length",
        "max_length",
        "n50",
        "median_length",
        "mean_q",
        "pct_mapped",
        "pct_mapq_ge30",
        "pct_clipped",
        "median_identity",
        "layout",
        "reads_without_md",
        "identity_reads",
        "identity_na",
        "bases_beyond_position_axis",
        "mapq_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "total_reads": {
          "$ref": "#/$defs/count"
        },
        "read1_reads": {
          "$ref": "#/$defs/count"
        },
        "read2_reads": {
          "$ref": "#/$defs/count"
        },
        "paired": {
          "$ref": "#/$defs/count"
        },
        "properly_paired": {
          "$ref": "#/$defs/count"
        },
        "secondary": {
          "$ref": "#/$defs/count"
        },
        "supplementary": {
          "$ref": "#/$defs/count"
        },
        "is_aligned": {
          "type": "boolean"
        },
        "is_partial_report": {
          "type": "boolean"
        },
        "total_bases": {
          "$ref": "#/$defs/count"
        },
        "min_length": {
          "$ref": "#/$defs/count"
        },
        "max_length": {
          "$ref": "#/$defs/count"
        },
        "n50": {
          "$ref": "#/$defs/count"
        },
        "median_length": {
          "$ref": "#/$defs/count"
        },
        "mean_q": {
          "$ref": "#/$defs/nullable_number"
        },
        "pct_mapped": {
          "$ref": "#/$defs/nullable_number"
        },
        "pct_mapq_ge30": {
          "$ref": "#/$defs/nullable_number"
        },
        "pct_clipped": {
          "$ref": "#/$defs/nullable_number"
        },
        "median_identity": {
          "$ref": "#/$defs/nullable_number"
        },
        "layout": {
          "enum": [
            "short",
            "long"
          ]
        },
        "reads_without_md": {
          "$ref": "#/$defs/count"
        },
        "identity_reads": {
          "$ref": "#/$defs/count"
        },
        "identity_na": {
          "$ref": "#/$defs/count"
        },
        "bases_beyond_position_axis": {
          "$ref": "#/$defs/count"
        },
        "mapq_counts": {
          "type": "object",
          "required": [
            "read1"
          ],
          "additionalProperties": false,
          "properties": {
            "read1": {
              "$ref": "#/$defs/bin_counts"
            },
            "read2": {
              "$ref": "#/$defs/bin_counts"
            }
          }
        }
      }
    },
    "mapq_bins": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/bin_entry"
        },
        {
          "$ref": "#/$defs/bin_entry"
        },
        {
          "$ref": "#/$defs/bin_entry"
        },
        {
          "$ref": "#/$defs/bin_entry"
        }
      ],
      "items": false
    },
    "axes": {
      "type": "object",
      "required": [
        "length_edges",
        "absolute",
        "relative",
        "identity_bins",
        "quality_error_scale"
      ],
      "additionalProperties": false,
      "properties": {
        "length_edges": {
          "$ref": "#/$defs/counts"
        },
        "absolute": {
          "$ref": "#/$defs/axis"
        },
        "relative": {
          "$ref": "#/$defs/axis"
        },
        "identity_bins": {
          "$ref": "#/$defs/count"
        },
        "quality_error_scale": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "read1": {
      "$ref": "#/$defs/read"
    },
    "read2": {
      "$ref": "#/$defs/read"
    }
  },
  "$defs": {
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "axis": {
      "type": "object",
      "required": [
        "bins",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "bins": {
          "$ref": "#/$defs/count"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "read": {
      "type": "object",
      "required": [
        "n_reads",
        "length",
        "read_mean_q",
        "identity",
        "absolute",
        "relative"
      ],
      "additionalProperties": false,
      "properties": {
        "n_reads": {
          "$ref": "#/$defs/count"
        },
        "length": {
          "type": "object",
          "required": [
            "reads",
            "bases"
          ],
          "additionalProperties": false,
          "properties": {
            "reads": {
              "$ref": "#/$defs/per_bin_counts"
            },
            "bases": {
              "$ref": "#/$defs/per_bin_counts"
            }
          }
        },
        "read_mean_q": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "identity": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "absolute": {
          "$ref": "#/$defs/position"
        },
        "relative": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "position": {
      "type": "object",
      "required": [
        "composition",
        "qual_bases",
        "qual_error_sum",
        "aligned",
        "aligned_md",
        "mismatches",
        "insertions",
        "deletions"
      ],
      "additionalProperties": false,
      "properties": {
        "composition": {
          "$ref": "#/$defs/per_bin_bases"
        },
        "qual_bases": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "qual_error_sum": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "aligned": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "aligned_md": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "mismatches": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "mismatch_base": {
          "description": "mismatches split by the read base (added in 2.5.0; optional, format_version stays 2). For every class and bin the five arrays add up to mismatches.",
          "$ref": "#/$defs/per_bin_bases"
        },
        "insertions": {
          "$ref": "#/$defs/per_bin_counts"
        },
        "deletions": {
          "$ref": "#/$defs/per_bin_counts"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/count"
      }
    },
    "bin_entry": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "mapq_ge30",
            "mapq_10_29",
            "mapq_lt10",
            "unmapped"
          ]
        },
        "label": {
          "type": "string"
        }
      }
    },
    "bin_counts": {
      "type": "object",
      "required": [
        "mapq_ge30",
        "mapq_10_29",
        "mapq_lt10",
        "unmapped"
      ],
      "additionalProperties": false,
      "properties": {
        "mapq_ge30": {
          "$ref": "#/$defs/count"
        },
        "mapq_10_29": {
          "$ref": "#/$defs/count"
        },
        "mapq_lt10": {
          "$ref": "#/$defs/count"
        },
        "unmapped": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "per_bin_counts": {
      "type": "object",
      "required": [
        "mapq_ge30",
        "mapq_10_29",
        "mapq_lt10",
        "unmapped"
      ],
      "additionalProperties": false,
      "properties": {
        "mapq_ge30": {
          "$ref": "#/$defs/counts"
        },
        "mapq_10_29": {
          "$ref": "#/$defs/counts"
        },
        "mapq_lt10": {
          "$ref": "#/$defs/counts"
        },
        "unmapped": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "base_counts": {
      "type": "object",
      "required": [
        "A",
        "C",
        "G",
        "T",
        "N"
      ],
      "additionalProperties": false,
      "properties": {
        "A": {
          "$ref": "#/$defs/counts"
        },
        "C": {
          "$ref": "#/$defs/counts"
        },
        "G": {
          "$ref": "#/$defs/counts"
        },
        "T": {
          "$ref": "#/$defs/counts"
        },
        "N": {
          "$ref": "#/$defs/counts"
        }
      }
    },
    "per_bin_bases": {
      "type": "object",
      "required": [
        "mapq_ge30",
        "mapq_10_29",
        "mapq_lt10",
        "unmapped"
      ],
      "additionalProperties": false,
      "properties": {
        "mapq_ge30": {
          "$ref": "#/$defs/base_counts"
        },
        "mapq_10_29": {
          "$ref": "#/$defs/base_counts"
        },
        "mapq_lt10": {
          "$ref": "#/$defs/base_counts"
        },
        "unmapped": {
          "$ref": "#/$defs/base_counts"
        }
      }
    }
  }
}
