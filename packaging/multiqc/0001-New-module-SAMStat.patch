--- /dev/null
+++ b/multiqc/modules/samstat/tests/test_samstat.py
@@ -0,0 +1,193 @@
+"""Tests for the SAMStat module: parsing, derived values and edge cases."""
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from multiqc import report
+from multiqc.base_module import ModuleNoSamplesFound
+from multiqc.modules.samstat.samstat import MultiqcModule, _length_plot_edge, _mean_q
+
+CLASSES = ["mapq_ge30", "mapq_10_29", "mapq_lt10", "unmapped"]
+SCALE = 1 << 30
+
+
+def _report(
+    name: str,
+    aligned: bool = True,
+    lengths: dict[int, int] | None = None,
+    identity: dict[int, int] | None = None,
+    version: int = 2,
+) -> dict[str, Any]:
+    """A small SAMStat JSON report (format version 2), read 1 only, all reads in one class."""
+    lengths = lengths or {100: 3, 150: 1}
+    identity = identity or {}
+    cls = "mapq_ge30" if aligned else "unmapped"
+    n = sum(lengths.values())
+    edges = list(range(1001))
+    len_reads = {c: [0] * 1001 for c in CLASSES}
+    for length, count in lengths.items():
+        len_reads[cls][length] = count
+    ident = {c: [] for c in CLASSES}
+    if identity:
+        ident["mapq_ge30"] = [identity.get(b, 0) for b in range(1001)]
+
+    def rel(value: int) -> dict[str, list[int]]:
+        return {c: ([value] * 100 if c == cls else []) for c in CLASSES}
+
+    return {
+        "format_version": version,
+        "meta": {"samstat_version": "2.4.0", "input_file": name},
+        "summary": {
+            "total_reads": n,
+            "read1_reads": n,
+            "read2_reads": 0,
+            "total_bases": sum(k * v for k, v in lengths.items()),
+            "min_length": min(lengths),
+            "max_length": max(lengths),
+            "n50": max(lengths),
+            "median_length": min(lengths),
+            "mean_q": 30.0,
+            "layout": "short",
+            "is_aligned": aligned,
+            "secondary": 0,
+            "supplementary": 0,
+            "pct_mapped": 100.0 if aligned else None,
+            "pct_mapq_ge30": 100.0 if aligned else None,
+            "pct_clipped": 0.0 if aligned else None,
+            "median_identity": 99.0 if identity else None,
+            "identity_reads": sum(identity.values()),
+            "mapq_counts": {"read1": {c: (n if c == cls else 0) for c in CLASSES}},
+        },
+        "axes": {
+            "length_edges": edges,
+            "relative": {"bins": 100},
+            "identity_bins": 1001,
+            "quality_error_scale": SCALE,
+        },
+        "read1": {
+            "length": {"reads": len_reads},
+            "identity": ident,
+            "relative": {
+                "qual_bases": rel(10),
+                # Q30: error probability 0.001 per base
+                "qual_error_sum": rel(round(10 * 0.001 * SCALE)),
+                "aligned": rel(1000 if aligned else 0),
+                "aligned_md": rel(1000 if aligned else 0),
+                "mismatches": rel(5 if aligned else 0),
+                "insertions": rel(2 if aligned else 0),
+                "deletions": rel(1 if aligned else 0),
+            },
+        },
+    }
+
+
+def _run(tmp_path: Path, files: dict[str, Any]) -> MultiqcModule:
+    for fn, content in files.items():
+        (tmp_path / fn).write_text(content if isinstance(content, str) else json.dumps(content))
+    report.reset()
+    report.analysis_files = [str(tmp_path)]
+    report.search_files(["samstat"])
+    return MultiqcModule()
+
+
+def _plot_data(module: MultiqcModule, anchor: str) -> Any:
+    section = next(s for s in module.sections if s.anchor == anchor)
+    return section
+
+
+def _line_points(plot_id: str, sample: str, tab: int = 0) -> dict[Any, Any]:
+    """The {x: y} points drawn for a sample on one tab of a line plot."""
+    lines = [line for line in report.plot_by_id[plot_id].datasets[tab].lines if line.name == sample]
+    return dict(lines[0].pairs) if lines else {}
+
+
+def _line_samples(plot_id: str, tab: int = 0) -> set:
+    return {line.name for line in report.plot_by_id[plot_id].datasets[tab].lines}
+
+
+def test_aligned_and_fastq(tmp_path):
+    m = _run(
+        tmp_path,
+        {
+            "a.bam.samstat.json": _report("a.bam", identity={990: 2, 1000: 2}),
+            "b.fastq.gz.samstat.json": _report("b.fastq.gz", aligned=False),
+        },
+    )
+    # sample names: the input file name, cleaned of its extensions
+    assert set(m.samstat_data) == {"a", "b"}
+    a, b = m.samstat_data["a"], m.samstat_data["b"]
+    assert a["total_reads"] == 4 and a["pct_mapq_ge30"] == 100.0 and a["pct_unmapped"] == 0.0
+    assert a["read1_mapq_ge30"] == 4
+    # FASTQ: no alignment columns at all (not zeros)
+    assert "pct_mapq_ge30" not in b and "pct_unmapped" not in b and "median_identity" not in b
+    anchors = {s.anchor for s in m.sections}
+    assert {"samstat-mapq", "samstat-length", "samstat-quality", "samstat-errors", "samstat-identity"} <= anchors
+
+
+def test_values(tmp_path):
+    m = _run(tmp_path, {"a.bam.samstat.json": _report("a.bam", identity={990: 1, 995: 1, 1000: 2})})
+    rep = m.samstat_reports["a"]
+    # mean Q from the error sums: 10 bases at Q30 per bin
+    rel = rep["read1"]["relative"]
+    assert _mean_q(rel["qual_error_sum"]["mapq_ge30"][0], 10, SCALE) == pytest.approx(30.0, abs=0.01)
+    # errors per aligned base, in percent: 5, 2 and 1 per 1000 bases in every bin
+    assert _line_points("samstat-errors-plot", "a", 0)[50] == pytest.approx(0.5)
+    assert _line_points("samstat-errors-plot", "a", 1)[50] == pytest.approx(0.2)
+    assert _line_points("samstat-errors-plot", "a", 2)[50] == pytest.approx(0.1)
+    assert _line_points("samstat-quality-plot", "a")[1] == pytest.approx(30.0, abs=0.01)
+
+
+def test_identity_is_cumulative(tmp_path):
+    m = _run(tmp_path, {"a.bam.samstat.json": _report("a.bam", identity={990: 1, 995: 1, 1000: 2})})
+    section = _plot_data(m, "samstat-identity")
+    assert section is not None
+    # computed line: 100 % at 99.0, 75 % from 99.1 to 99.5, 50 % from 99.6 to 100
+    points = _line_points("samstat-identity-plot", "a")
+    assert points[99.0] == pytest.approx(100.0)
+    assert points[99.5] == pytest.approx(75.0)
+    assert points[100.0] == pytest.approx(50.0)
+
+
+def test_single_length_left_out_of_length_plot(tmp_path):
+    m = _run(
+        tmp_path,
+        {
+            "one.bam.samstat.json": _report("one.bam", lengths={150: 10}),
+            "two.bam.samstat.json": _report("two.bam", lengths={100: 3, 150: 1}),
+        },
+    )
+    section = _plot_data(m, "samstat-length")
+    assert section.plot_anchor is not None
+    assert _line_samples("samstat-length-plot") == {"two"}
+    assert "one" in str(section.alerts)
+
+
+def test_only_single_length_keeps_section_without_plot(tmp_path):
+    m = _run(tmp_path, {"one.bam.samstat.json": _report("one.bam", lengths={150: 10})})
+    section = _plot_data(m, "samstat-length")
+    assert section.plot_anchor is None and "single" in str(section.alerts)
+
+
+def test_old_format_and_other_json_are_skipped(tmp_path):
+    with pytest.raises(ModuleNoSamplesFound):
+        _run(
+            tmp_path,
+            {
+                "old.bam.samstat.json": _report("old.bam", version=1),
+                "x.samstat.json": "not json at all",
+            },
+        )
+
+
+def test_length_plot_edges():
+    assert [_length_plot_edge(e) for e in (1, 50, 100)] == [1, 50, 100]
+    # 20 bins per decade above 100 bp: 112, 126, ..., 1000, 1122, ...
+    assert _length_plot_edge(101) == 100
+    assert _length_plot_edge(113) == 112
+    assert _length_plot_edge(1000) == 1000
+    assert _length_plot_edge(1121) == 1000
+    assert _length_plot_edge(1123) == 1122
+    assert _length_plot_edge(10**6) == 10**6
