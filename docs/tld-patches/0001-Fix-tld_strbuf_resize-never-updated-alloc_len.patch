From cc35f6e1c0a4c602048ef756d0550608627c2907 Mon Sep 17 00:00:00 2001
From: Timo Lassmann <timolassmann@icloud.com>
Date: Wed, 14 Oct 2026 14:10:49 +0800
Subject: [PATCH] Fix: tld_strbuf_resize never updated alloc_len

Every append after the first growth reallocated and copied the whole
buffer (quadratic). Add a regression test: 1e6 appends, alloc_len >= len,
fewer than 64 reallocations.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/string/str.c                  |  1 +
 tests/CMakeLists.txt              |  1 +
 tests/utests/unit_strbuf_growth.c | 32 +++++++++++++++++++++++++++++++
 3 files changed, 34 insertions(+)
 create mode 100644 tests/utests/unit_strbuf_growth.c

diff --git a/src/string/str.c b/src/string/str.c
index c4ab459..49da24b 100644
--- a/src/string/str.c
+++ b/src/string/str.c
@@ -48,6 +48,7 @@ int tld_strbuf_resize(tld_strbuf *b, int new_size)
 
                 gfree(b->str);
                 b->str = tmp;
+                b->alloc_len = new_size;
         }
         return OK;
 ERROR:
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 4c13af9..d66c5bb 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -57,6 +57,7 @@ add_custom_test(unit-qnorm utests/unit_qnorm.c)
 add_custom_test(unit-auc utests/unit_auc.c)
 add_custom_test(unit-shuffle utests/unit_shuffle.c)
 add_custom_test(unit-misc utests/unit_misc.c)
+add_custom_test(unit-strbuf-growth utests/unit_strbuf_growth.c)
 add_custom_test(unit-timing utests/unit_timing.c)
 add_custom_test(unit-sort utests/unit_sort.c)
 add_custom_test(unit-sigmoid utests/unit_sigmoid.c)
diff --git a/tests/utests/unit_strbuf_growth.c b/tests/utests/unit_strbuf_growth.c
new file mode 100644
index 0000000..47d140a
--- /dev/null
+++ b/tests/utests/unit_strbuf_growth.c
@@ -0,0 +1,32 @@
+#include "tld.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+/* Regression test: tld_strbuf_resize must update alloc_len, otherwise every
+ * append after the first growth reallocates and copies the whole buffer. */
+int main(void)
+{
+        tld_strbuf* b = NULL;
+        int reallocs = 0;
+        int last_alloc = 0;
+        const int n = 1000000;
+
+        RUN(tld_strbuf_alloc(&b, 16));
+        last_alloc = b->alloc_len;
+        for(int i = 0; i < n; i++){
+                RUN(tld_append_char(b, 'a'));
+                ASSERT(b->alloc_len >= b->len, "alloc_len %d < len %d", b->alloc_len, b->len);
+                if(b->alloc_len != last_alloc){
+                        reallocs++;
+                        last_alloc = b->alloc_len;
+                }
+        }
+        ASSERT(b->len == n, "len is %d", b->len);
+        ASSERT(reallocs < 64, "too many reallocations: %d", reallocs);
+        LOG_MSG("reallocs: %d", reallocs);
+        tld_strbuf_free(b);
+        return EXIT_SUCCESS;
+ERROR:
+        tld_strbuf_free(b);
+        return EXIT_FAILURE;
+}
