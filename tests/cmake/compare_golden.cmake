# Compare a samstat JSON report against a golden file, ignoring the 'meta' member
# (version and file name are the only things allowed to differ).
# Usage: cmake -DACTUAL=<json> -DEXPECTED=<json> -P compare_golden.cmake
#        cmake -DACTUAL=<json> -DEXPECTED=<json> -DUPDATE=ON -P compare_golden.cmake
# The second form overwrites EXPECTED with ACTUAL; it is used by run_golden.cmake
# through the 'update-goldens' target (the one way to regenerate goldens).

cmake_minimum_required(VERSION 3.19)

if(NOT ACTUAL OR NOT EXISTS "${ACTUAL}")
  message(FATAL_ERROR "compare_golden: ACTUAL not found: '${ACTUAL}'")
endif()
if(NOT EXPECTED)
  message(FATAL_ERROR "compare_golden: EXPECTED not given")
endif()

if(UPDATE)
  get_filename_component(dir "${EXPECTED}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  file(COPY_FILE "${ACTUAL}" "${EXPECTED}")
  message(STATUS "compare_golden: updated ${EXPECTED}")
  return()
endif()

if(NOT EXISTS "${EXPECTED}")
  message(FATAL_ERROR "compare_golden: EXPECTED not found: ${EXPECTED}\n(create it with -DUPDATE=ON)")
endif()

file(READ "${ACTUAL}" actual)
file(READ "${EXPECTED}" expected)

string(JSON actual ERROR_VARIABLE err REMOVE "${actual}" meta)
if(NOT err STREQUAL "NOTFOUND")
  message(FATAL_ERROR "compare_golden: ACTUAL is not valid JSON or has no 'meta': ${err}")
endif()
string(JSON expected ERROR_VARIABLE err REMOVE "${expected}" meta)
if(NOT err STREQUAL "NOTFOUND")
  message(FATAL_ERROR "compare_golden: EXPECTED is not valid JSON or has no 'meta': ${err}")
endif()

string(JSON same EQUAL "${actual}" "${expected}")
if(same)
  return()
endif()

# Report the first differing dotted path (object keys and array indices, as in check_json).
set_property(GLOBAL PROPERTY CG_FIRST "")

# find_diff(<actual-container-json> <expected-container-json> <path-prefix>)
# Sets global property CG_FIRST to the first differing path below the prefix.
function(find_diff a e prefix)
  string(JSON ta TYPE "${a}")
  if(ta STREQUAL "OBJECT")
    string(JSON n LENGTH "${a}")
    set(keys_a)
    if(n GREATER 0)
      math(EXPR last "${n}-1")
      foreach(i RANGE ${last})
        string(JSON key MEMBER "${a}" ${i})
        list(APPEND keys_a "${key}")
      endforeach()
    endif()
    foreach(key IN LISTS keys_a)
      set(child "${key}")
      if(NOT prefix STREQUAL "")
        set(child "${prefix}.${key}")
      endif()
      string(JSON te ERROR_VARIABLE err TYPE "${e}" "${key}")
      if(NOT err STREQUAL "NOTFOUND")
        set_property(GLOBAL PROPERTY CG_FIRST "${child} (missing in EXPECTED)")
        return()
      endif()
      compare_child("${a}" "${e}" "${key}" "${child}")
      get_property(found GLOBAL PROPERTY CG_FIRST)
      if(NOT found STREQUAL "")
        return()
      endif()
    endforeach()
    string(JSON ne LENGTH "${e}")
    if(ne GREATER 0)
      math(EXPR laste "${ne}-1")
      foreach(i RANGE ${laste})
        string(JSON key MEMBER "${e}" ${i})
        string(JSON ta2 ERROR_VARIABLE err TYPE "${a}" "${key}")
        if(NOT err STREQUAL "NOTFOUND")
          set(child "${key}")
          if(NOT prefix STREQUAL "")
            set(child "${prefix}.${key}")
          endif()
          set_property(GLOBAL PROPERTY CG_FIRST "${child} (missing in ACTUAL)")
          return()
        endif()
      endforeach()
    endif()
  elseif(ta STREQUAL "ARRAY")
    string(JSON n LENGTH "${a}")
    string(JSON ne LENGTH "${e}")
    set(m ${n})
    if(ne LESS m)
      set(m ${ne})
    endif()
    if(m GREATER 0)
      math(EXPR lastm "${m}-1")
      foreach(i RANGE ${lastm})
        set(child "${i}")
        if(NOT prefix STREQUAL "")
          set(child "${prefix}.${i}")
        endif()
        compare_child("${a}" "${e}" "${i}" "${child}")
        get_property(found GLOBAL PROPERTY CG_FIRST)
        if(NOT found STREQUAL "")
          return()
        endif()
      endforeach()
    endif()
    if(NOT n EQUAL ne)
      set_property(GLOBAL PROPERTY CG_FIRST "${prefix} (array length ${n} in ACTUAL, ${ne} in EXPECTED)")
    endif()
  endif()
endfunction()

# compare_child(<a> <e> <key-or-index> <path>): compare one member of two containers.
function(compare_child a e key path)
  string(JSON ta TYPE "${a}" "${key}")
  string(JSON te TYPE "${e}" "${key}")
  if(NOT ta STREQUAL te)
    set_property(GLOBAL PROPERTY CG_FIRST "${path} (type ${ta} in ACTUAL, ${te} in EXPECTED)")
    return()
  endif()
  string(JSON ja GET "${a}" "${key}")
  string(JSON je GET "${e}" "${key}")
  if(ta STREQUAL "OBJECT" OR ta STREQUAL "ARRAY")
    string(JSON same EQUAL "${ja}" "${je}")
    if(NOT same)
      find_diff("${ja}" "${je}" "${path}")
    endif()
  elseif(NOT ja STREQUAL je)
    set_property(GLOBAL PROPERTY CG_FIRST "${path} (ACTUAL ${ja}, EXPECTED ${je})")
  endif()
endfunction()

find_diff("${actual}" "${expected}" "")
get_property(first GLOBAL PROPERTY CG_FIRST)
if(first STREQUAL "")
  set(first "(unknown; members compare equal one by one)")
endif()
message(FATAL_ERROR "compare_golden: ${ACTUAL} differs from ${EXPECTED}\nfirst differing path: ${first}\n(regenerate with 'cmake --build <build> --target update-goldens' if the change is intended)")
